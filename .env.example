# Supabase project URL and the anon (public) key.
# Leave these blank to run without accounts. The app shows "Accounts are not configured"
# and will not crash. A season already saved in this browser can still be finished locally.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PIN sign-in is the pin-auth Edge Function, not a Vite variable.
# Set PIN_PEPPER in Supabase → Edge Functions → Secrets (at least 16 random characters).
# Never put the service-role key in this file.

# Site base path. Leave unset for local dev and tunnels (Vite uses /).
# The GitHub Pages workflow sets this to /yes-lemonade-startup/.
# VITE_BASE=/yes-lemonade-startup/
